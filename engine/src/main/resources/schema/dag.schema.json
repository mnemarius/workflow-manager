{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow DAG (M1)",
  "type": "object",
  "required": ["tasks"],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["key"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "maxAttempts": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
